# 101 - Crie um programa que tenha uma função chamada voto() que vai receber como parâmetro o ano de nascimento de uma pessoa, retornando um valor literal indicando se uma pessoa tem voto NEGADO, OPCIONAL e OBRIGATÓRIO nas eleições.
def  vote(ano):
    from datetime import date
    atual= date.today().year
    idade = atual - ano
    if  1 < idade < 16:
        return f"Com {idade}, NÃO PODE VOTAR"
    if 16 <= idade < 18 or idade > 65:
        return f"Com {idade}, VOTO OPCIONAL"
    elif 0 >= idade:
        return f"IDADE INCORRETA"
    else:
        return f"Com {idade}, VOTO OBRIGATÓRIO"

nas= int(input("Qual ano que vc nasceu? "))
print (vote(nas))
